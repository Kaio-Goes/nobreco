rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Fotos dos produtos: leitura pública (loja), escrita por qualquer usuário autenticado
    // (o controle de quem pode logar é feito direto no Firebase Authentication).
    match /produtos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
